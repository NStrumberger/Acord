{
  "name": "acord",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "English to Romanian translation that gets grammatical gender right. Runs in the browser, works offline.",
  "license": "MIT",
  "homepage": "https://nstrumberger.github.io/Acord/",
  "repository": {
    "type": "git",
    "url": "https://github.com/NStrumberger/Acord.git"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run typecheck && npm run test:unit",
    "typecheck": "tsc --noEmit",
    "test:unit": "node --test \"test/**/*.ts\"",
    "shots": "node scripts/shots.mjs",
    "check:webkit": "node scripts/webkit-check.mjs",
    "check:offline": "node scripts/offline-check.mjs",
    "check:people": "node scripts/people-check.mjs",
    "check:update": "npm run build && node scripts/update-check.mjs",
    "icons": "node scripts/make-icons.mjs",
    "demo": "node scripts/demo.ts",
    "mt:fixture": "node scripts/make_mt_fixture.mjs",
    "data:extract": "python scripts/extract_pairs.py",
    "data:kaikki": "python scripts/extract_kaikki.py",
    "data:build": "python scripts/build_lexicon.py",
    "data:spike": "python scripts/spike_feminine.py",
    "data:validate": "node scripts/validate_articles.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@types/node": "^26.6.2",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
